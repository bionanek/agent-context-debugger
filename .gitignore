# Build artifact. Regenerate with `python3 build_real_view.py`.
# Not tracked: it bakes full session transcripts, so it is both large (~13MB)
# and a copy of whatever was said in those sessions.
agent-context-ide-real.html

# Scratch tree the snapshot harness restores frozen inputs into before re-baking.
# Regenerated on every capture/verify; the frozen inputs themselves are tracked.
snapshots/.restore/

# The optional ast-grep binary, downloaded on consent by install_ast_grep.py.
# Never committed: it is a ~10MB platform-specific binary, and the pinned
# digest in the installer is what makes it reproducible.
vendor/

__pycache__/
.pytest_cache/
.venv/
.DS_Store

# Frozen calibration corpus: raw transcripts with private content, never committed
snapshots/baseline/
snapshots/after/
